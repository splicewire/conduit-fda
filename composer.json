{
    "name": "splicewire/conduit-fda",
    "description": "openFDA drug-shortage integration for Splicewire: a Saloon connector/request for the drug shortages endpoint, plus a manually-run sync command that feeds laravel-knowledge-engine's OpenFdaShortageSource.",
    "autoload": {
        "psr-4": {
            "Splicewire\\Fda\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "rushing/php-popcorn": "dev-main",
        "saloonphp/saloon": "^2.0|^3.0",
        "saloonphp/rate-limit-plugin": ">=2",
        "splicewire/laravel-knowledge-engine": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Fda\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Splicewire\\Fda\\PackageServiceProvider"
            ]
        },
        "package-topology": {
            "because": "a conduit is a narrow, persistence-agnostic HTTP source connector (see splicewire/conduit-ecfr) — it depends only on its transport (Saloon) and the knowledge-engine's parsing spine (StatusSource/OpenFdaShortageSource/ConceptStatus DTO), never on the Eloquent persistence tier.",
            "mustNotRequire": [
                "splicewire/laravel-satellite-knowledge",
                "splicewire/tower"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../rushing/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../schemastud/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "pint": "vendor/bin/pint"
    }
}
